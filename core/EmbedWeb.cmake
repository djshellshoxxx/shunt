# Generates WebAssets.cpp: shunt::core::webAsset(path) -> {data, size, mime}.
file(GLOB files RELATIVE ${DIR} ${DIR}/*)
list(SORT files)
set(body "// Generated by EmbedWeb.cmake; do not edit.\n#include <cstddef>\n#include <cstring>\nnamespace shunt::core {\nstruct WebAsset { const char* path; const unsigned char* data; size_t size; const char* mime; };\n")
set(table "")
set(i 0)
foreach(f ${files})
  file(READ ${DIR}/${f} hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  set(mime "application/octet-stream")
  if(f MATCHES "\\.html$")
    set(mime "text/html; charset=utf-8")
  elseif(f MATCHES "\\.js$")
    set(mime "application/javascript")
  elseif(f MATCHES "\\.css$")
    set(mime "text/css")
  elseif(f MATCHES "\\.svg$")
    set(mime "image/svg+xml")
  elseif(f MATCHES "\\.json$")
    set(mime "application/json")
  endif()
  string(APPEND body "static const unsigned char a${i}[] = {${arr}0};\n")
  string(APPEND table "  {\"/${f}\", a${i}, ${size}, \"${mime}\"},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "static const WebAsset kAssets[] = {\n${table}  {nullptr, nullptr, 0, nullptr}};\n")
string(APPEND body "const WebAsset* webAsset(const char* path) {\n  for (const WebAsset* a = kAssets; a->path; ++a) if (std::strcmp(a->path, path) == 0) return a;\n  return nullptr;\n}\n} // namespace shunt::core\n")
file(WRITE ${OUT} "${body}")
